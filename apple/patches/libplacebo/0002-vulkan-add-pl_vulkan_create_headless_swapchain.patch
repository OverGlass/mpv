 src/vulkan/meson.build          |   1 +
 src/vulkan/swapchain_headless.c | 327 ++++++++++++++++++++++++++++++++
 3 files changed, 415 insertions(+)
 create mode 100644 src/vulkan/swapchain_headless.c

diff --git a/src/include/libplacebo/vulkan.h b/src/include/libplacebo/vulkan.h
index f873f54..b282585 100644
--- a/src/include/libplacebo/vulkan.h
+++ b/src/include/libplacebo/vulkan.h
@@ -616,6 +616,92 @@ struct pl_vulkan_release_params {
 // "Release" a shared image, transferring control to libplacebo.
 PL_API void pl_vulkan_release_ex(pl_gpu gpu, const struct pl_vulkan_release_params *params);
 
+// Headless swapchain — for embedding the libplacebo render pipeline into
+// presentation systems that don't expose a VkSurfaceKHR (e.g. media frameworks
+// that consume IOSurface- or DMA-buf-backed VkImages directly). The user owns
+// the VkImage pool; libplacebo treats those VkImages as the backing store for
+// `pl_swapchain_frame.fbo`.
+//
+// Lifecycle:
+//   - `pl_vulkan_create_headless_swapchain` wraps each user-supplied VkImage
+//     into a `pl_tex` via `pl_vulkan_wrap` once at creation time.
+//   - On every `pl_swapchain_start_frame`, the swapchain calls
+//     `params->acquire` to ask the user which image to render into.
+//   - On every `pl_swapchain_submit_frame`, the swapchain calls
+//     `params->present` with the image's index and a binary semaphore that
+//     fires when the GPU is done writing. The user must wait on that
+//     semaphore before reading the image (i.e. before performing the
+//     platform-specific present operation).
+//
+// Resize semantics: not supported. To change the image pool, destroy this
+// swapchain and create a new one.
+
+struct pl_vulkan_headless_swapchain_params {
+    // The user-allocated VkImages. The user must keep these alive for the
+    // lifetime of the resulting `pl_swapchain`. All images must have been
+    // created with identical `format`, `width`, `height`, and `usage`
+    // (matching the fields below). The minimum required usage flags are
+    // `VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT`.
+    int      num_images;
+    VkImage *images;
+
+    // Image properties shared by every entry in `images`.
+    VkFormat          format;
+    int               width;
+    int               height;
+    VkImageUsageFlags usage;
+
+    // The color representation and color space of the swapchain images.
+    // Reported back via `pl_swapchain_frame.color_{repr,space}`. Unlike a
+    // surface-backed swapchain (which negotiates these with the platform),
+    // the user states what color space their images are in.
+    struct pl_color_repr  color_repr;
+    struct pl_color_space color_space;
+
+    // Maximum number of in-flight frames before `pl_swapchain_swap_buffers`
+    // backpressures the caller. Optional, defaults to 2 — fits the typical
+    // small-pool model used by embedded media frameworks (one image being
+    // displayed, one ready, one being written).
+    int swapchain_depth;
+
+    // Consumer-supplied callback invoked from `pl_swapchain_start_frame` to
+    // pick the next image to render into. The callee must set `*out_index`
+    // to a value in [0, `num_images`) that is currently free (i.e. not
+    // being read by the consumer's present path).
+    //
+    // Return `false` to indicate "no image available, drop this frame";
+    // `pl_swapchain_start_frame` will then return `false` and
+    // `vo_gpu_next` will skip the frame. (Required.)
+    bool (*acquire)(void *priv, int *out_index);
+
+    // Consumer-supplied callback invoked from `pl_swapchain_submit_frame`
+    // after libplacebo has finished writing to image `index`. `sem_wait`
+    // is a binary VkSemaphore which signals when the GPU is done writing;
+    // the consumer must wait on it (e.g. via `vkQueueSubmit` with a wait
+    // stage of `VK_PIPELINE_STAGE_TRANSFER_BIT` or by importing the
+    // semaphore as an `MTLSharedEvent`) before reading the underlying
+    // resource.
+    //
+    // The semaphore's lifetime is bound to the swapchain — do not destroy
+    // it. (Required.)
+    void (*present)(void *priv, int index, pl_vulkan_sem sem_wait);
+
+    // Opaque pointer passed back to both callbacks. Optional.
+    void *priv;
+};
+
+#define pl_vulkan_headless_swapchain_params(...) \
+    (&(struct pl_vulkan_headless_swapchain_params) { __VA_ARGS__ })
+
+// Create a headless swapchain. See `pl_vulkan_headless_swapchain_params` for
+// the contract. Returns NULL on failure.
+//
+// The swapchain takes a non-owning reference to `params->images`; the user
+// remains responsible for `vkDestroyImage` on each entry. Wrapping each
+// image as a `pl_tex` happens once at creation time via `pl_vulkan_wrap`.
+PL_API pl_swapchain pl_vulkan_create_headless_swapchain(pl_vulkan vk,
+        const struct pl_vulkan_headless_swapchain_params *params);
+
 struct pl_vulkan_sem_params {
     // The type of semaphore to create.
     VkSemaphoreType type;
