+
+// Headless swapchain backend.
+//
+// Mirrors the structure of `vulkan/swapchain.c` (the surface-backed
+// implementation), with the surface dance excised: there is no
+// VkSurfaceKHR, no vkAcquireNextImageKHR, no vkQueuePresentKHR. Instead
+// the user supplies a fixed pool of VkImages at create time and two
+// per-frame callbacks (`acquire`, `present`) that map image-index to the
+// user's external presentation system (e.g. AVSampleBufferDisplayLayer +
+// IOSurface, or DMA-buf + a Wayland sub-surface).
+//
+// The synchronisation contract is the same as a surface swapchain:
+//   start_frame → libplacebo writes to fbo
+//   submit_frame → libplacebo signals `sem_wait`
+//   user waits on `sem_wait` before reading the underlying VkImage
+//
+// Layout transitions: pl_vulkan_release_ex(VK_IMAGE_LAYOUT_UNDEFINED) on
+// acquire (image is producer-owned and free); pl_vulkan_hold_ex with
+// VK_IMAGE_LAYOUT_GENERAL + VK_QUEUE_FAMILY_EXTERNAL on submit (Metal /
+// the foreign API takes ownership; GENERAL because external APIs like
+// Metal are layout-agnostic over the IOSurface backing store).
+
+#include "command.h"
+#include "common.h"
+#include "gpu.h"
+#include "swapchain.h"
+#include "utils.h"
+#include "pl_thread.h"
+
+struct priv {
+    struct pl_sw_fns impl;
+
+    pl_mutex lock;
+    struct vk_ctx *vk;
+
+    // Configuration captured at create time. Immutable.
+    int num_images;
+    int width, height;
+    VkFormat format;
+    struct pl_color_repr color_repr;
+    struct pl_color_space color_space;
+    int swapchain_depth;
+
+    bool (*acquire)(void *priv, int *out_index);
+    void (*present)(void *priv, int index, pl_vulkan_sem sem_wait);
+    void *cb_priv;
+
+    // Per-image state. Indices match `params->images` 1:1.
+    PL_ARRAY(pl_tex) images;        // pl_tex wrappers, one per VkImage
+    PL_ARRAY(VkSemaphore) sems_out; // present-wait semaphores, one per image
+
+    // The image index returned by the most recent `acquire`. Reset to -1
+    // in `submit_frame` so a misuse pattern (submit without start) is
+    // caught by `pl_assert`.
+    int last_index;
+
+    // Backpressure: incremented in `submit_frame`'s GPU command, decremented
+    // when that command completes. `swap_buffers` blocks until the count
+    // drops below `swapchain_depth`. Same model as the surface swapchain.
+    pl_rc_t frames_in_flight;
+};
+
+static const struct pl_sw_fns vulkan_headless_swapchain;
+
+static void vk_hsw_destroy(pl_swapchain sw)
+{
+    pl_gpu gpu = sw->gpu;
+    struct priv *p = PL_PRIV(sw);
+    struct vk_ctx *vk = p->vk;
+
+    // Make sure no in-flight commands still reference our resources.
+    pl_gpu_flush(gpu);
+    vk_wait_idle(vk);
+
+    for (int i = 0; i < p->images.num; i++)
+        pl_tex_destroy(gpu, &p->images.elem[i]);
+    for (int i = 0; i < p->sems_out.num; i++)
+        vk->DestroySemaphore(vk->dev, p->sems_out.elem[i], PL_VK_ALLOC);
+
+    pl_mutex_destroy(&p->lock);
+    pl_free((void *) sw);
+}
+
+static int vk_hsw_latency(pl_swapchain sw)
+{
+    struct priv *p = PL_PRIV(sw);
+    return p->swapchain_depth;
+}
+
+static bool vk_hsw_start_frame(pl_swapchain sw,
+                               struct pl_swapchain_frame *out_frame)
+{
+    struct priv *p = PL_PRIV(sw);
+    pl_mutex_lock(&p->lock);
+
+    int idx = -1;
+    if (!p->acquire(p->cb_priv, &idx)) {
+        // Consumer doesn't have a free image — drop this frame, same as
+        // the wayland VK_NOT_READY convention in the surface backend.
+        pl_mutex_unlock(&p->lock);
+        return false;
+    }
+    if (idx < 0 || idx >= p->num_images) {
+        PL_ERR(sw, "headless swapchain: acquire callback returned invalid "
+                   "index %d (have %d images)", idx, p->num_images);
+        pl_mutex_unlock(&p->lock);
+        return false;
+    }
+
+    pl_tex tex = p->images.elem[idx];
+    p->last_index = idx;
+
+    // The consumer guarantees the image is currently free, so no
+    // semaphore wait is required. Layout starts as UNDEFINED — libplacebo
+    // will discard prior contents and transition to a renderable layout.
+    pl_vulkan_release_ex(sw->gpu, pl_vulkan_release_params(
+        .tex    = tex,
+        .layout = VK_IMAGE_LAYOUT_UNDEFINED,
+        .qf     = VK_QUEUE_FAMILY_IGNORED,
+    ));
+
+    *out_frame = (struct pl_swapchain_frame) {
+        .fbo         = tex,
+        .flipped     = false,
+        .color_repr  = p->color_repr,
+        .color_space = p->color_space,
+    };
+
+    // Lock stays held — released in submit_frame, matching the surface
+    // backend's start/submit pairing contract.
+    return true;
+}
+
+static void present_cb(struct priv *p, void *arg)
+{
+    (void) pl_rc_deref(&p->frames_in_flight);
+}
+
+VK_CB_FUNC_DEF(present_cb);
+
+static bool vk_hsw_submit_frame(pl_swapchain sw)
+{
+    pl_gpu gpu = sw->gpu;
+    struct priv *p = PL_PRIV(sw);
+    pl_assert(p->last_index >= 0 && p->last_index < p->num_images);
+    int idx = p->last_index;
+    p->last_index = -1;
+
+    VkSemaphore sem_out = p->sems_out.elem[idx];
+
+    // Hand the image to the consumer via VK_QUEUE_FAMILY_EXTERNAL — that's
+    // the conventional "ownership transfer to a foreign API" flag, exactly
+    // what we need for IOSurface/DMA-buf consumption from Metal/Wayland.
+    // Layout: GENERAL. Metal accesses IOSurface contents through its own
+    // layout abstraction; Vulkan's idea of a layout doesn't apply once
+    // ownership has crossed the queue-family boundary, and GENERAL is the
+    // only Vulkan layout guaranteed compatible with all subsequent uses.
+    bool held = pl_vulkan_hold_ex(gpu, pl_vulkan_hold_params(
+        .tex       = p->images.elem[idx],
+        .layout    = VK_IMAGE_LAYOUT_GENERAL,
+        .qf        = VK_QUEUE_FAMILY_EXTERNAL,
+        .semaphore = { sem_out },
+    ));
+    if (!held) {
+        PL_ERR(gpu, "headless swapchain: failed holding image %d for present", idx);
+        pl_mutex_unlock(&p->lock);
+        return false;
+    }
+
+    // Submit the pending command buffer (containing the layout transition
+    // queued by hold_ex) and arm the in-flight counter. The counter is
+    // decremented from `present_cb` once the GPU finishes that submission,
+    // which is the same instant `sem_out` is signalled.
+    struct vk_cmd *cmd = pl_vk_steal_cmd(gpu);
+    if (!cmd) {
+        pl_mutex_unlock(&p->lock);
+        return false;
+    }
+
+    pl_rc_ref(&p->frames_in_flight);
+    vk_cmd_callback(cmd, VK_CB_FUNC(present_cb), p, NULL);
+    if (!vk_cmd_submit(&cmd)) {
+        // pl_rc_ref / present_cb are paired by `vk_cmd_submit` semantics:
+        // a failed submission never invokes the callback, so we need to
+        // back out the increment ourselves.
+        (void) pl_rc_deref(&p->frames_in_flight);
+        pl_mutex_unlock(&p->lock);
+        return false;
+    }
+
+    pl_mutex_unlock(&p->lock);
+
+    // Notify the consumer outside the lock — the callback may take time
+    // (e.g. enqueueing a CMSampleBuffer on the main thread) and we don't
+    // want it to block the next start_frame.
+    p->present(p->cb_priv, idx, (pl_vulkan_sem) { .sem = sem_out });
+    return true;
+}
+
+static void vk_hsw_swap_buffers(pl_swapchain sw)
+{
+    struct priv *p = PL_PRIV(sw);
+
+    pl_mutex_lock(&p->lock);
+    while (pl_rc_count(&p->frames_in_flight) >= p->swapchain_depth) {
+        pl_mutex_unlock(&p->lock); // never block while holding the mutex
+        vk_poll_commands(p->vk, UINT64_MAX);
+        pl_mutex_lock(&p->lock);
+    }
+    pl_mutex_unlock(&p->lock);
+}
+
+static const struct pl_sw_fns vulkan_headless_swapchain = {
+    .destroy      = vk_hsw_destroy,
+    .latency      = vk_hsw_latency,
+    .start_frame  = vk_hsw_start_frame,
+    .submit_frame = vk_hsw_submit_frame,
+    .swap_buffers = vk_hsw_swap_buffers,
+};
+
+pl_swapchain pl_vulkan_create_headless_swapchain(pl_vulkan plvk,
+        const struct pl_vulkan_headless_swapchain_params *params)
+{
+    struct vk_ctx *vk = PL_PRIV(plvk);
+    pl_gpu gpu = plvk->gpu;
+
+    if (!params || params->num_images <= 0 || !params->images) {
+        PL_ERR(gpu, "pl_vulkan_create_headless_swapchain: image pool is empty");
+        return NULL;
+    }
+    if (!params->acquire || !params->present) {
+        PL_ERR(gpu, "pl_vulkan_create_headless_swapchain: acquire and present "
+                    "callbacks are required");
+        return NULL;
+    }
+    if (params->width <= 0 || params->height <= 0) {
+        PL_ERR(gpu, "pl_vulkan_create_headless_swapchain: invalid dimensions "
+                    "%dx%d", params->width, params->height);
+        return NULL;
+    }
+    if (params->format == VK_FORMAT_UNDEFINED) {
+        PL_ERR(gpu, "pl_vulkan_create_headless_swapchain: format is required");
+        return NULL;
+    }
+
+    static const VkImageUsageFlags req_usage =
+        VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    if ((params->usage & req_usage) != req_usage) {
+        PL_ERR(gpu, "pl_vulkan_create_headless_swapchain: usage flags must "
+                    "include COLOR_ATTACHMENT and TRANSFER_DST (got 0x%x)",
+               (unsigned) params->usage);
+        return NULL;
+    }
+
+    struct pl_swapchain_t *sw = pl_zalloc_obj(NULL, sw, struct priv);
+    sw->log = vk->log;
+    sw->gpu = gpu;
+
+    struct priv *p = PL_PRIV(sw);
+    pl_mutex_init(&p->lock);
+    p->impl            = vulkan_headless_swapchain;
+    p->vk              = vk;
+    p->num_images      = params->num_images;
+    p->width           = params->width;
+    p->height          = params->height;
+    p->format          = params->format;
+    p->color_repr      = params->color_repr;
+    p->color_space     = params->color_space;
+    p->swapchain_depth = PL_DEF(params->swapchain_depth, 2);
+    p->acquire         = params->acquire;
+    p->present         = params->present;
+    p->cb_priv         = params->priv;
+    p->last_index      = -1;
+    pl_assert(p->swapchain_depth > 0);
+    atomic_init(&p->frames_in_flight, 0);
+
+    PL_ARRAY_RESIZE(sw, p->images, params->num_images);
+    PL_ARRAY_RESIZE(sw, p->sems_out, params->num_images);
+
+    static const VkSemaphoreCreateInfo seminfo = {
+        .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
+    };
+    char name[64];
+
+    for (int i = 0; i < params->num_images; i++) {
+        if (params->images[i] == VK_NULL_HANDLE) {
+            PL_ERR(gpu, "pl_vulkan_create_headless_swapchain: images[%d] is "
+                        "VK_NULL_HANDLE", i);
+            goto error;
+        }
+
+        snprintf(name, sizeof(name), "headless swapchain #%d", i);
+        pl_tex tex = pl_vulkan_wrap(gpu, pl_vulkan_wrap_params(
+            .image     = params->images[i],
+            .width     = params->width,
+            .height    = params->height,
+            .format    = params->format,
+            .usage     = params->usage,
+            .debug_tag = name,
+        ));
+        if (!tex) {
+            PL_ERR(gpu, "pl_vulkan_create_headless_swapchain: pl_vulkan_wrap "
+                        "failed for image %d", i);
+            goto error;
+        }
+        p->images.elem[i] = tex;
+        p->images.num     = i + 1;
+
+        VkResult res = vk->CreateSemaphore(vk->dev, &seminfo, PL_VK_ALLOC,
+                                           &p->sems_out.elem[i]);
+        if (res != VK_SUCCESS) {
+            PL_ERR(gpu, "pl_vulkan_create_headless_swapchain: vkCreateSemaphore: "
+                        "%s", vk_res_str(res));
+            goto error;
+        }
+        p->sems_out.num = i + 1;
+
+        snprintf(name, sizeof(name), "headless swapchain out #%d", i);
+        PL_VK_NAME(SEMAPHORE, p->sems_out.elem[i], name);
+    }
+
+    return sw;
+
+error:
+    vk_hsw_destroy(sw);
+    return NULL;
+}
